rules_version='2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /products/{productId} {
   allow read: if true;
   allow create,update,delete: if request.auth != null && request.auth.token.email != null;
  }
  match /orders/{orderId} {
   allow create: if request.resource.data.customerName is string && request.resource.data.phone is string && request.resource.data.address is string && request.resource.data.total is number && request.resource.data.items is list && request.resource.data.items.size() > 0;
   allow read,update,delete: if request.auth != null && request.auth.token.email != null;
  }
 }
}
